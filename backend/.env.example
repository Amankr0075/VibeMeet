PORT=5000
MONGODB_URI=mongodb://localhost:27017/vibemeet
JWT_SECRET=replace-with-a-long-random-secret
GROQ_API_KEY=

# SMTP settings for verification emails. For Gmail, use smtp.gmail.com, port 587,
# and a Google App Password (not your normal Google password).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="VibeMeet <no-reply@example.com>"
