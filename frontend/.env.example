# Public HTTPS address of the backend tunnel used by the deployed Vercel app.
# Do not use localhost here: Vercel visitors would resolve it to their own device.
VITE_API_URL=https://your-current-tunnel.ngrok-free.app
VITE_SOCKET_URL=https://your-current-tunnel.ngrok-free.app

# Required for reliable calls between users on different networks. Configure a
# coturn or managed TURN service and use time-limited credentials in production.
VITE_TURN_URL=turn:turn.example.com:3478
VITE_TURN_USERNAME=your-turn-username
VITE_TURN_CREDENTIAL=your-turn-password
